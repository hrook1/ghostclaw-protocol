{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/rpc", "destination": "/api/rpc" },
    { "source": "/note-tree", "destination": "/api/note-tree" },
    { "source": "/alchemy/sponsor", "destination": "/api/alchemy-sponsor" },
    { "source": "/facilitator/verify", "destination": "/api/facilitator-verify" },
    { "source": "/demo/address-report", "destination": "/api/demo-address-report" }
  ],
  "headers": [
    {
      "source": "/proving/1.5.0/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "functions": {
    "api/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@ghostclaw/prover-linux-x64/**"
    }
  }
}
